#!/bin/sh
set -eu

mode=${1:-check}
shift || true
if [ ! -e node_modules ]; then
    if [ "${CHECK_WRITABLE:-0}" = 1 ]; then
        cp -R /opt/node-deps/node_modules node_modules
    else
        ln -s /opt/node-deps/node_modules node_modules
    fi
fi

lint() {
    npm run lint:internal
    /opt/venv/bin/python /opt/check/check-yaml.py
    /opt/check-tools/node_modules/.bin/markdownlint-cli2
}

generate() {
    if [ ! -f v1/ergogen/config.yaml ]; then
        printf '%s\n' 'Generation requires v1/ergogen/config.yaml, which is not included in this checkout.' >&2
        exit 2
    fi
    for module in ergogen/footprints/ceoloide ergogen/footprints/infused-kim ergogen/kb_ergogen_helper; do
        if [ ! -d "$module" ] || [ -z "$(find "$module" -mindepth 1 -maxdepth 1 -print -quit)" ]; then
            printf '%s\n' "Required submodule is not initialized: $module" >&2
            exit 2
        fi
    done
    PATH=/opt/node/bin:/usr/local/bin:/usr/bin:/bin npm run build:internal
}

case "$mode" in
    check) lint ;;
    lint) lint ;;
    build) printf '%s\n' 'No build check declared' >&2; exit 2 ;;
    generate) generate ;;
    test) printf '%s\n' 'No test suite declared' >&2; exit 2 ;;
    exec)
        if [ "$#" -gt 0 ]; then exec "$@"; fi
        exec sh -ec "${COMMAND:?COMMAND must be provided}"
        ;;
    *) printf '%s\n' "Unknown check category: $mode" >&2; exit 2 ;;
esac
